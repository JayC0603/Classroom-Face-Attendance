# Local development only. Replace every value outside an isolated developer machine.
POSTGRES_DB=face_recognition_dev
POSTGRES_USER=face_recognition_dev
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55432
REDIS_PORT=56379
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MINIO_ROOT_USER=face-recognition-dev
MINIO_ROOT_PASSWORD=local-minio-password-change-me

# Backend-only runtime values; never expose these through feature configuration APIs.
FR_POSTGRES_DSN=postgresql://face_recognition_dev:local-development-only@127.0.0.1:55432/face_recognition_dev
FR_AUTH_RATE_LIMIT_KEY=replace-with-a-random-secret-at-least-32-characters-long
REDIS_URL=redis://127.0.0.1:56379/0
EVIDENCE_ROOT=data/evidence
# Generate a private key with scripts/setup-local.ps1 before starting the API.
FR_WORKER_INTERNAL_TOKEN=<generate-a-random-local-token>
MINIO_ENDPOINT=127.0.0.1:59000
MINIO_ACCESS_KEY=face-recognition-dev
MINIO_SECRET_KEY=local-minio-password-change-me
MINIO_MODELS_BUCKET=models
MINIO_FACE_IMAGES_BUCKET=face-images
MINIO_EVIDENCE_BUCKET=evidence
